{
  "name": "personal-ai-agent",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @personal-agent/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:smoke": "tsx packages/infrastructure/src/demo.ts"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.44.7",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "cors": "^2.8.6",
    "drizzle-kit": "^0.31.11",
    "fastify": "^5.12.7",
    "pg": "^8.23.1"
  }
}
